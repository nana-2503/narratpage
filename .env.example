# 复制为 .env 后按需修改；.env 已在 .gitignore 中
JWT_SECRET=please-change-this-jwt-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
BLOG_PORT=8080
# 站点对外地址（RSS 绝对链接用）
SITE_URL=http://localhost:8080

# 数据库配置（默认 SQLite，可选 mysql / pgsql）
DB_TYPE=sqlite
# DB_DSN=  # MySQL: user:password@tcp(127.0.0.1:3306)/blog?charset=utf8mb4
# DB_DSN=  # PostgreSQL: postgres://user:password@127.0.0.1:5432/blog?sslmode=disable

# Redis 配置（可选）
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
