# 复制为 .env 后按需修改；.env 已在 .gitignore 中

# ---------- 安全 ----------
# 生产环境务必修改：改后需重启容器，已签发的 token 会失效
JWT_SECRET=please-change-this-jwt-secret
# 首次安装时创建的初始管理员；仅在 users 表为空时生效
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 初始管理员邮箱（可选）
# ADMIN_EMAIL=

# ---------- 站点 ----------
BLOG_PORT=8080
# 站点对外地址（RSS / sitemap / canonical 用）
SITE_URL=http://localhost:8080

# ---------- 代理信任 ----------
# 后端是否位于可信反向代理之后。
# true  : 限流会解析 X-Forwarded-For 取真实客户端 IP（nginx 部署时开启）
# false : 直接对外时必须关闭，否则客户端可伪造该头绕过限流
# 双容器 compose 默认已按「nginx 在前」设为 true；一体化部署为 false
TRUST_PROXY=true

# ---------- 数据库 ----------
# sqlite | mysql | pgsql；进程启动时读取，切换需重启容器
DB_TYPE=sqlite
# MySQL:       user:password@tcp(db-host:3306)/blog?charset=utf8mb4&parseTime=true&loc=Local
# PostgreSQL:  postgres://user:password@db-host:5432/blog?sslmode=disable
# DB_DSN=
# 使用内置 compose profile 时会自动填好，通常无需手写
# DB_NAME=blog
# DB_USER=narratpage
# DB_PASSWORD=narratpage
# DB_ROOT_PASSWORD=rootpass

# ---------- Redis（可选） ----------
# 用于登录限流的多实例共享；单实例部署可不启用
REDIS_ENABLED=false
# REDIS_URL=redis://127.0.0.1:6379
